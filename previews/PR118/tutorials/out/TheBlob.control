\begin{CONTROL_INPUT}
   \begin{RUN_PARAMETERS}
      mesh file name = out/TheBlob.mesh
      plot file format = skeleton
      plot file name = out/TheBlob.tec
      stats file name = out/TheBlob.txt
      mesh file format = ISM-V2
      polynomial order = 5
   \end{RUN_PARAMETERS}

   \begin{BACKGROUND_GRID}
      background grid size = [0.5,0.5,0.0]
   \end{BACKGROUND_GRID}

   \begin{SPRING_SMOOTHER}
      smoothing type = LinearAndCrossbarSpring
      smoothing = ON
      number of iterations = 15
   \end{SPRING_SMOOTHER}

   \begin{REFINEMENT_REGIONS}
         \begin{REFINEMENT_CENTER}
            name = region
            w = 1.0
            x0 = [-4.0,-0.5,0.0]
            type = smooth
            h = 0.4
         \end{REFINEMENT_CENTER}
   \end{REFINEMENT_REGIONS}

\end{CONTROL_INPUT}

\begin{MODEL}
   \begin{OUTER_BOUNDARY}
      optimize = none
      tolerance = 1e-3
      continuity = 0
         \begin{PARAMETRIC_EQUATION_CURVE}
            name = Blob
            yEqn = y(t) = 4 * sin(2 * pi * t) - 0.5 * sin(11* pi * t)^2
            zEqn = z(t) = 0.0
            xEqn = x(t) = 4 * cos(2 * pi * t) - 0.6 * cos(8 * pi * t)^3
         \end{PARAMETRIC_EQUATION_CURVE}
   \end{OUTER_BOUNDARY}

\end{MODEL}

\end{FILE}
