\begin{CONTROL_INPUT}
   \begin{RUN_PARAMETERS}
      mesh file name = out/symmetric_mesh.mesh
      plot file format = skeleton
      plot file name = out/symmetric_mesh.tec
      stats file name = out/symmetric_mesh.txt
      mesh file format = ISM-V2
      polynomial order = 6
   \end{RUN_PARAMETERS}

   \begin{BACKGROUND_GRID}
      background grid size = [0.25,0.25,0.0]
   \end{BACKGROUND_GRID}

   \begin{SPRING_SMOOTHER}
      smoothing type = LinearAndCrossbarSpring
      smoothing = ON
      number of iterations = 15
   \end{SPRING_SMOOTHER}

\end{CONTROL_INPUT}

\begin{MODEL}
   \begin{OUTER_BOUNDARY}
      optimize = none
      tolerance = 1e-3
      continuity = 0
         \begin{END_POINTS_LINE}
            name = left
            xEnd = [-0.05,0.0,0.0]
            xStart = [-0.05,2.0,0.0]
         \end{END_POINTS_LINE}
         \begin{END_POINTS_LINE}
            name = bottom
            xEnd = [1.0,0.0,0.0]
            xStart = [-0.05,0.0,0.0]
         \end{END_POINTS_LINE}
         \begin{END_POINTS_LINE}
            name = :symmetry
            xEnd = [1.0,0.5,0.0]
            xStart = [1.0,0.0,0.0]
         \end{END_POINTS_LINE}
         \begin{CIRCULAR_ARC}
            name = circle
            units = degrees
            radius = 0.25
            start angle = 270.0
            center = [1.0,0.75,0.0]
            end angle = 90.0
         \end{CIRCULAR_ARC}
         \begin{END_POINTS_LINE}
            name = :symmetry
            xEnd = [1.0,1.5,0.0]
            xStart = [1.0,1.0,0.0]
         \end{END_POINTS_LINE}
         \begin{END_POINTS_LINE}
            name = bump
            xEnd = [0.75,1.5,0.0]
            xStart = [1.0,1.5,0.0]
         \end{END_POINTS_LINE}
         \begin{END_POINTS_LINE}
            name = bump
            xEnd = [0.75,1.75,0.0]
            xStart = [0.75,1.5,0.0]
         \end{END_POINTS_LINE}
         \begin{END_POINTS_LINE}
            name = bump
            xEnd = [1.0,1.75,0.0]
            xStart = [0.75,1.75,0.0]
         \end{END_POINTS_LINE}
         \begin{END_POINTS_LINE}
            name = :symmetry
            xEnd = [1.0,2.0,0.0]
            xStart = [1.0,1.75,0.0]
         \end{END_POINTS_LINE}
         \begin{END_POINTS_LINE}
            name = top
            xEnd = [-0.05,2.0,0.0]
            xStart = [1.0,2.0,0.0]
         \end{END_POINTS_LINE}
   \end{OUTER_BOUNDARY}

\end{MODEL}

\end{FILE}
